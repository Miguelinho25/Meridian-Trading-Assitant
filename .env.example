# =============================================================================
# Meridian — example environment. Copy to `.env` and fill in.
#   cp .env.example .env
#
# `.env` is gitignored. NEVER put real values in this file.
# No key in this file is ever read by the frontend; see SECRETS BOUNDARY below.
# =============================================================================

# -----------------------------------------------------------------------------
# EXECUTION SAFETY — the most important block in this file.
# These defaults are the safe defaults. Changing them is a deliberate act.
# -----------------------------------------------------------------------------

# research | backtest | paper | broker
# `broker` is NOT implemented in this build. Setting it fails startup.
MERIDIAN_MODE=research

# Master switch for any real-money broker connection.
# Hard-wired to false in this build; the code path does not exist.
MERIDIAN_BROKER_EXECUTION_ENABLED=false

# OBSERVE_ONLY | MANUAL_APPROVAL | AUTO_PAPER_RESTRICTED | AUTO_PAPER_FULL
MERIDIAN_APPROVAL_MODE=MANUAL_APPROVAL

# Global kill switch. When true, no new trade proposals may be submitted.
# Fail-closed: if this value cannot be read, the system behaves as if true.
MERIDIAN_KILL_SWITCH=false

# System-wide hard ceiling on per-trade risk, in percent of account equity.
# The risk engine clamps every profile to this. No profile, prompt, UI control
# or API call can exceed it. Lower it freely; raising it is a code+config review.
MERIDIAN_MAX_RISK_PER_TRADE_PCT=1.00

# PRESERVATION | CHALLENGE | ASSERTIVE | EXPERIMENTAL | CUSTOM
MERIDIAN_RISK_PROFILE=CHALLENGE

# -----------------------------------------------------------------------------
# DATABASE
# sqlite for local development; postgresql for anything shared or durable.
# The schema is dialect-neutral; see docs/data-model.md.
# -----------------------------------------------------------------------------
MERIDIAN_STORAGE_BACKEND=sqlite
MERIDIAN_DATABASE_URL=sqlite+aiosqlite:///./var/meridian.db
# MERIDIAN_DATABASE_URL=postgresql+asyncpg://meridian:CHANGE_ME@localhost:5432/meridian

# -----------------------------------------------------------------------------
# CACHE / EVENT BUS
# `memory` runs in-process and needs no service. `redis` requires a running Redis.
# -----------------------------------------------------------------------------
MERIDIAN_EVENT_BUS=memory
# MERIDIAN_REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# MARKET DATA
# synthetic | replay | csv | parquet. No paid API is required to run this build.
# -----------------------------------------------------------------------------
MERIDIAN_MARKET_DATA_PROVIDER=synthetic
MERIDIAN_MARKET_DATA_SEED=20260727

# Data older than this blocks new orders (fail-closed). Seconds.
MERIDIAN_MAX_DATA_AGE_SECONDS=60

# -----------------------------------------------------------------------------
# MODEL ROUTER
# The application is fully functional with every one of these unset.
# Absent key => provider reports `unconfigured` => router falls back or degrades
# to no-LLM mode. It never silently proceeds with a broken provider.
# -----------------------------------------------------------------------------

# Local worker (tagging, summarisation, classification, embeddings).
MERIDIAN_OLLAMA_ENABLED=true
MERIDIAN_OLLAMA_BASE_URL=http://localhost:11434
MERIDIAN_OLLAMA_WORKER_MODEL=qwen3:8b
MERIDIAN_OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Cloud providers — DISABLED BY DEFAULT. Enabling sends data off this machine.
# Read docs/security.md on what is redacted before you turn these on.
MERIDIAN_ANTHROPIC_ENABLED=false
# ANTHROPIC_API_KEY=

MERIDIAN_OPENAI_ENABLED=false
# OPENAI_API_KEY=

# Hard cap on cloud model spend per day, in USD. Router refuses above this.
MERIDIAN_MODEL_DAILY_COST_CAP_USD=5.00

# -----------------------------------------------------------------------------
# OBSIDIAN VAULT
# Defaults to the in-repo vault. Point it at an external vault only if you
# understand the sync boundary in docs/obsidian-memory.md — Meridian writes
# files there and takes backups before overwriting.
# -----------------------------------------------------------------------------
MERIDIAN_VAULT_PATH=./obsidian-vault
MERIDIAN_VAULT_SYNC_ENABLED=true

# -----------------------------------------------------------------------------
# API / WEB
# -----------------------------------------------------------------------------
MERIDIAN_API_HOST=127.0.0.1
MERIDIAN_API_PORT=8787
MERIDIAN_CORS_ORIGINS=http://localhost:3000
MERIDIAN_LOG_LEVEL=INFO
MERIDIAN_LOG_FORMAT=json

# Frontend. NEXT_PUBLIC_* is compiled into the browser bundle.
# Never place a secret behind a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_MERIDIAN_API_URL=http://localhost:8787

# =============================================================================
# SECRETS BOUNDARY
#
#   1. Provider API keys are read by the backend process only.
#   2. The frontend receives model *results*, never credentials.
#   3. Logs pass through redaction middleware before any sink.
#   4. Prompts pass through redaction before leaving the process.
#   5. Nothing in this file is written to the Obsidian vault.
#
# If you find a secret in a log, a prompt, the vault, or a NEXT_PUBLIC_ var,
# treat it as an incident: rotate the key, then fix the leak.
# =============================================================================
